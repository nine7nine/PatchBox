+/* patchbox (from teams-sdl-cef): wait for the display fd (readable, or writable with `write`) or the wakeup eventfd
+ * (Wayland_SendWakeupEvent), to the nanosecond like SDL_IOReady. Returns 1 when the display is
+ * ready, 2 when only the wakeup fired (drained), 0 on timeout, -1 on error with errno set (EINTR
+ * included, as SDL_IOR_NO_RETRY would). */
+static int Wayland_WaitDisplayOrWakeup(SDL_VideoData *d, int display_fd, bool write, Sint64 timeoutNS)
+{
+    const short display_events = write ? POLLOUT : POLLIN;
+
+    if (d->wakeup_fd < 0) {
+        return SDL_IOReady(display_fd, (write ? SDL_IOR_WRITE : SDL_IOR_READ) | SDL_IOR_NO_RETRY, timeoutNS);
+    }
+
+    struct pollfd fds[2];
+    fds[0].fd = display_fd;
+    fds[0].events = display_events;
+    fds[0].revents = 0;
+    fds[1].fd = d->wakeup_fd;
+    fds[1].events = POLLIN;
+    fds[1].revents = 0;
+    struct timespec timeout;
+    if (timeoutNS >= 0) {
+        timeout.tv_sec = (time_t)(timeoutNS / SDL_NS_PER_SECOND);
+        timeout.tv_nsec = (long)(timeoutNS % SDL_NS_PER_SECOND);
+    }
+    const int ret = ppoll(fds, 2, timeoutNS >= 0 ? &timeout : NULL, NULL);
+    if (ret <= 0) {
+        return ret;
+    }
+    if (fds[1].revents & POLLIN) {
+        Uint64 count;
+        (void)read(d->wakeup_fd, &count, sizeof(count));
+        if (!(fds[0].revents & (display_events | POLLERR | POLLHUP))) {
+            return 2;
+        }
+    }
+    return 1;
+}
